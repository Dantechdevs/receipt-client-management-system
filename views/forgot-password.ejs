<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-box">
      <h1>Reset Password</h1>
      <p class="sub">Enter your account email</p>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
      <% if (resetLink) { %>
        <p style="font-size:13px;">Reset link: <a href="<%= resetLink %>"><%= resetLink %></a></p>
      <% } %>
      <form method="POST" action="/forgot-password">
        <div class="form-group">
          <label>Email</label>
          <input class="form-control" type="email" name="email" required autofocus>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;">Send reset link</button>
      </form>
      <p style="margin-top:14px; font-size:12.5px;"><a href="/login">Back to login</a></p>
    </div>
  </div>
  <footer class="devcredit">
    Developed by <a href="https://dantechdevelopers.com" target="_blank" rel="noopener noreferrer">Dantechdevs Developers</a>
  </footer>
</body>
</html>
