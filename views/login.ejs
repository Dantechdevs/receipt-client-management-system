<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – Receipt & Client Manager</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-bg-collage">
      <div style="background-image:url('/public/images/bg-borehole.png');"></div>
      <div style="background-image:url('/public/images/bg-solar.png');"></div>
      <div style="background-image:url('/public/images/bg-cctv.png');"></div>
    </div>
    <div class="login-bg-overlay"></div>
    <div class="login-box">
      <% if (company && company.logo_path) { %>
        <img src="<%= company.logo_path %>" alt="<%= company.name %> logo" style="max-height:60px; max-width:180px; display:block; margin:0 auto 16px;">
      <% } %>
      <h1 style="text-align:center;"><%= (company && company.name) ? company.name : 'Receipt & Client Manager' %></h1>
      <p class="sub" style="text-align:center;">Sign in to continue</p>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <div class="form-group">
          <label>Email</label>
          <input class="form-control" type="email" name="email" required autofocus>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input class="form-control" type="password" name="password" required>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;">Sign in</button>
      </form>
      <p style="margin-top:14px; font-size:12.5px;"><a href="/forgot-password">Forgot your password?</a></p>
      <p style="margin-top:18px; font-size:11.5px; color:#94a3b8;">
        Demo: admin@example.com / Admin@123 (Administrator)<br>
        cashier@example.com / Cashier@123 (Cashier)
      </p>
    </div>
  </div>
  <footer class="devcredit">
    Developed by <a href="https://dantechdevelopers.com" target="_blank" rel="noopener noreferrer">Dantechdevs Developers</a>
  </footer>
</body>
</html>
