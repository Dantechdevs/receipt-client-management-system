<%- include('../partials/header', { title: doc ? 'Edit Agreement' : 'New Agreement' }) %>
  <div class="topbar">
    <h1><%= doc ? `Edit Agreement ${doc.doc_number}` : 'New Agreement Form' %></h1>
    <a href="/agreements" class="btn">Cancel</a>
  </div>
  <div class="content">
    <form method="POST" action="<%= doc ? `/agreements/${doc.id}?_method=PUT` : '/agreements' %>" id="agreementForm">
      <div class="grid grid-2">
        <div class="card">
          <h3 style="margin-top:0;">Client Details</h3>
          <div class="form-group">
            <label>Client Name *</label>
            <input class="form-control" type="text" name="customer_name" required value="<%= doc ? doc.customer_name : '' %>">
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input class="form-control" type="text" name="customer_phone" value="<%= doc ? (doc.customer_phone || '') : '' %>">
          </div>
          <div class="form-group">
            <label>Address</label>
            <input class="form-control" type="text" name="customer_address" value="<%= doc ? (doc.customer_address || '') : '' %>">
          </div>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Agreement Details</h3>
          <div class="form-group">
            <label>Status</label>
            <select class="form-control" name="status">
              <% config.statuses.forEach(s => { %>
                <option value="<%= s %>" <%= (doc ? doc.status === s : s === config.defaultStatus) ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Effective Date</label>
            <input class="form-control" type="date" name="effective_date" value="<%= doc && doc.effective_date ? doc.effective_date.substring(0,10) : '' %>">
          </div>
          <div class="form-group">
            <label>Notes</label>
            <textarea class="form-control" name="notes" rows="2"><%= doc ? (doc.notes || '') : '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Parties -->
      <div class="card" style="margin-top:16px;">
        <h3 style="margin-top:0;">Parties & Signatories</h3>
        <table class="data-table" id="partiesTable">
          <thead><tr><th style="width:25%;">Role</th><th style="width:40%;">Full Name</th><th>Phone (optional)</th><th></th></tr></thead>
          <tbody id="partiesBody">
            <% parties.forEach(p => { %>
            <tr>
              <td><input class="form-control" name="party_roles" value="<%= p.role %>" placeholder="e.g. Client, Contractor, Witness"></td>
              <td><input class="form-control" name="party_names" value="<%= p.name %>" placeholder="Full name"></td>
              <td><input class="form-control" name="party_phones" value="<%= p.phone || '' %>"></td>
              <td><button type="button" class="remove-row" onclick="removeRow(this)">✕</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" class="btn btn-sm" onclick="addPartyRow()" style="margin-top:10px;">+ Add Party</button>
      </div>

      <!-- Clauses -->
      <div class="card" style="margin-top:16px;">
        <h3 style="margin-top:0;">Terms & Clauses</h3>
        <div id="clausesBody">
          <% clauses.forEach((c, idx) => { %>
          <div class="clause-block" style="border:1px solid #e2e8f0; border-radius:6px; padding:12px; margin-bottom:12px;">
            <div class="form-group">
              <label>Clause Title</label>
              <input class="form-control" name="clause_titles" value="<%= c.title %>" placeholder="e.g. Scope of Work">
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label>Clause Text</label>
              <textarea class="form-control" name="clause_bodies" rows="3" placeholder="Full clause text..."><%= c.body %></textarea>
            </div>
            <button type="button" class="remove-row" onclick="removeClause(this)" style="margin-top:8px;">✕ Remove Clause</button>
          </div>
          <% }) %>
        </div>
        <button type="button" class="btn btn-sm" onclick="addClause()">+ Add Clause</button>
      </div>

      <!-- Optional pricing schedule -->
      <div class="card" style="margin-top:16px;">
        <h3 style="margin-top:0;">Pricing Schedule (optional)</h3>
        <p style="color:#64748b; font-size:12.5px; margin-top:-8px;">Leave empty if this agreement doesn't include priced items.</p>
        <table class="data-table items-table" id="itemsTable">
          <thead>
            <tr><th style="width:45%;">Description</th><th>Qty</th><th>Unit Price</th><th>Line Total</th><th></th></tr>
          </thead>
          <tbody id="itemsBody">
            <% items.forEach((it) => { %>
            <tr>
              <td><input class="form-control" name="item_descriptions" value="<%= it.description %>" placeholder="Description"></td>
              <td><input class="form-control qty" type="number" step="0.01" min="0" name="item_quantities" value="<%= it.quantity %>"></td>
              <td><input class="form-control price" type="number" step="0.01" min="0" name="item_unit_prices" value="<%= it.unit_price %>"></td>
              <td class="lineTotal">0.00</td>
              <td><button type="button" class="remove-row" onclick="removeRow(this)">✕</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" class="btn btn-sm" onclick="addItemRow()" style="margin-top:10px;">+ Add Line Item</button>
        <div style="text-align:right; margin-top:16px; font-size:16px; font-weight:700;">
          Total: KES <span id="grandTotal">0.00</span>
        </div>
      </div>

      <div style="margin-top:16px; display:flex; gap:10px;">
        <button type="submit" class="btn btn-primary"><%= doc ? 'Save Changes' : 'Create Agreement' %></button>
        <a href="/agreements" class="btn">Cancel</a>
      </div>
    </form>
  </div>

<script>
function removeRow(btn) {
  const tbody = btn.closest('tbody');
  const rows = tbody.querySelectorAll('tr');
  if (rows.length > 1) btn.closest('tr').remove();
  else btn.closest('tr').querySelectorAll('input').forEach(i => i.value = '');
  recalc();
}
function addPartyRow() {
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input class="form-control" name="party_roles" placeholder="e.g. Client, Contractor, Witness"></td>
    <td><input class="form-control" name="party_names" placeholder="Full name"></td>
    <td><input class="form-control" name="party_phones"></td>
    <td><button type="button" class="remove-row" onclick="removeRow(this)">✕</button></td>
  `;
  document.getElementById('partiesBody').appendChild(tr);
}
function addClause() {
  const div = document.createElement('div');
  div.className = 'clause-block';
  div.style = 'border:1px solid #e2e8f0; border-radius:6px; padding:12px; margin-bottom:12px;';
  div.innerHTML = `
    <div class="form-group">
      <label>Clause Title</label>
      <input class="form-control" name="clause_titles" placeholder="e.g. Scope of Work">
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label>Clause Text</label>
      <textarea class="form-control" name="clause_bodies" rows="3" placeholder="Full clause text..."></textarea>
    </div>
    <button type="button" class="remove-row" onclick="removeClause(this)" style="margin-top:8px;">✕ Remove Clause</button>
  `;
  document.getElementById('clausesBody').appendChild(div);
}
function removeClause(btn) {
  const blocks = document.querySelectorAll('.clause-block');
  if (blocks.length > 1) btn.closest('.clause-block').remove();
  else btn.closest('.clause-block').querySelectorAll('input,textarea').forEach(i => i.value = '');
}
function itemRowTemplate() {
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input class="form-control" name="item_descriptions" placeholder="Description"></td>
    <td><input class="form-control qty" type="number" step="0.01" min="0" name="item_quantities" value="1"></td>
    <td><input class="form-control price" type="number" step="0.01" min="0" name="item_unit_prices" value="0"></td>
    <td class="lineTotal">0.00</td>
    <td><button type="button" class="remove-row" onclick="removeRow(this)">✕</button></td>
  `;
  return tr;
}
function addItemRow() {
  document.getElementById('itemsBody').appendChild(itemRowTemplate());
  attachListeners();
  recalc();
}
function recalc() {
  let grand = 0;
  document.querySelectorAll('#itemsBody tr').forEach(tr => {
    const qtyEl = tr.querySelector('.qty');
    const priceEl = tr.querySelector('.price');
    if (!qtyEl || !priceEl) return;
    const qty = parseFloat(qtyEl.value) || 0;
    const price = parseFloat(priceEl.value) || 0;
    const total = qty * price;
    tr.querySelector('.lineTotal').textContent = total.toLocaleString('en-KE', {minimumFractionDigits:2});
    grand += total;
  });
  document.getElementById('grandTotal').textContent = grand.toLocaleString('en-KE', {minimumFractionDigits:2});
}
function attachListeners() {
  document.querySelectorAll('#itemsBody .qty, #itemsBody .price').forEach(el => {
    el.removeEventListener('input', recalc);
    el.addEventListener('input', recalc);
  });
}
attachListeners();
recalc();
</script>
<%- include('../partials/footer') %>
