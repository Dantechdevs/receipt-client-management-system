<%- include('../partials/header', { title: 'Company Settings' }) %>
  <div class="topbar"><h1>Company Settings</h1></div>
  <div class="content">
    <% if (saved) { %><div class="alert alert-success">Settings saved successfully.</div><% } %>
    <form method="POST" action="/settings" enctype="multipart/form-data">
      <div class="grid grid-2">
        <div class="card">
          <h3 style="margin-top:0;">Company Details</h3>
          <div class="form-group"><label>Company Name</label><input class="form-control" name="name" value="<%= company.name %>" required></div>
          <div class="form-group"><label>Address</label><input class="form-control" name="address" value="<%= company.address || '' %>"></div>
          <div class="form-row">
            <div class="form-group"><label>Phone Number</label><input class="form-control" name="phone" value="<%= company.phone || '' %>"></div>
            <div class="form-group"><label>Email Address</label><input class="form-control" type="email" name="email" value="<%= company.email || '' %>"></div>
          </div>
          <div class="form-group"><label>Receipt Footer Message</label><textarea class="form-control" name="footer_message" rows="2"><%= company.footer_message || '' %></textarea></div>
          <div class="form-group"><label>Currency Code</label><input class="form-control" name="currency" value="<%= company.currency || 'KES' %>"></div>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Document Numbering</h3>
          <p style="color:#64748b; font-size:12.5px; margin-top:-8px;">Prefix used for each document type's auto-generated number (e.g. <code>QT-2026-000001</code>).</p>
          <div class="form-row">
            <div class="form-group"><label>Quotation Prefix</label><input class="form-control" name="quotation_prefix" value="<%= company.quotation_prefix || 'QT' %>"></div>
            <div class="form-group"><label>Invoice Prefix</label><input class="form-control" name="invoice_prefix" value="<%= company.invoice_prefix || 'INV' %>"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Receipt Prefix</label><input class="form-control" name="receipt_prefix" value="<%= company.receipt_prefix || 'RCP' %>"></div>
            <div class="form-group"><label>Agreement Prefix</label><input class="form-control" name="agreement_prefix" value="<%= company.agreement_prefix || 'AGR' %>"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top:16px;">
        <div class="card">
          <h3 style="margin-top:0;">Tax / VAT Defaults</h3>
          <p style="color:#64748b; font-size:12.5px; margin-top:-8px;">Sets the default when creating a new quotation, invoice, or receipt. Each document can still turn tax on/off or change the rate individually.</p>
          <div class="form-row">
            <div class="form-group"><label>Default Tax Label</label><input class="form-control" name="default_tax_label" value="<%= company.default_tax_label || 'VAT' %>" placeholder="e.g. VAT, GST, Sales Tax"></div>
            <div class="form-group"><label>Default Tax Rate (%)</label><input class="form-control" type="number" step="0.01" min="0" name="default_tax_rate" value="<%= company.default_tax_rate || 0 %>"></div>
          </div>
          <p style="color:#94a3b8; font-size:12px;">Set the rate to <strong>0</strong> if you don't charge tax by default — you can still enable it per document when needed.</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0;">Branding & Signatures</h3>
          <div class="form-group">
            <label>Company Logo</label>
            <% if (company.logo_path) { %><div style="margin-bottom:6px;"><img src="<%= company.logo_path %>" style="max-height:60px;"></div><% } %>
            <input class="form-control" type="file" name="logo" accept="image/*">
          </div>
          <div class="form-group">
            <label>Company Stamp</label>
            <% if (company.stamp_path) { %><div style="margin-bottom:6px;"><img src="<%= company.stamp_path %>" style="max-height:70px;"></div><% } %>
            <input class="form-control" type="file" name="stamp" accept="image/*">
          </div>
          <div class="form-group">
            <label>Authorized Signature</label>
            <% if (company.signature_path) { %><div style="margin-bottom:6px;"><img src="<%= company.signature_path %>" style="max-height:50px;"></div><% } %>
            <input class="form-control" type="file" name="signature" accept="image/*">
          </div>
        </div>
      </div>
      <button class="btn btn-primary" type="submit" style="margin-top:16px;">Save Settings</button>
    </form>
  </div>
<%- include('../partials/footer') %>
