<%- include('../partials/header', { title: 'Edit Client' }) %>
  <div class="topbar">
    <h1>Edit Client</h1>
    <a class="btn" href="/clients/<%= clientRecord.id %>">Cancel</a>
  </div>
  <div class="content">
    <div class="card" style="max-width:500px;">
      <form method="POST" action="/clients/<%= clientRecord.id %>?_method=PUT">
        <div class="form-group">
          <label>Name</label>
          <input class="form-control" type="text" name="name" value="<%= clientRecord.name %>" required>
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input class="form-control" type="text" name="phone" value="<%= clientRecord.phone || '' %>">
        </div>
        <div class="form-group">
          <label>Address</label>
          <input class="form-control" type="text" name="address" value="<%= clientRecord.address || '' %>">
        </div>
        <button class="btn btn-primary" type="submit">Save Changes</button>
      </form>
    </div>
  </div>
<%- include('../partials/footer') %>
