<%- include('../partials/header', { title: 'Clients' }) %>
  <div class="topbar">
    <h1>Clients</h1>
    <a href="/receipts/new" class="btn btn-primary">+ New Receipt</a>
  </div>
  <div class="content">
    <form class="search-bar" method="GET" action="/clients">
      <input type="text" name="q" placeholder="Search by name or phone" value="<%= query.q || '' %>" style="min-width:280px;">
      <button class="btn" type="submit">Search</button>
      <a class="btn" href="/clients">Reset</a>
    </form>
    <div class="card">
      <table class="data-table">
        <thead><tr><th>Name</th><th>Phone</th><th>Receipts</th><th>Total Spent (KES)</th><th>Last Activity</th></tr></thead>
        <tbody>
          <% clients.forEach(c => { %>
            <tr>
              <td><a href="/clients/<%= c.id %>"><%= c.name %></a></td>
              <td><%= c.phone || '—' %></td>
              <td><%= c.receipt_count %></td>
              <td><%= Number(c.total_spent).toLocaleString('en-KE',{minimumFractionDigits:2}) %></td>
              <td><%= c.last_activity ? new Date(c.last_activity).toLocaleDateString('en-GB') : '—' %></td>
            </tr>
          <% }) %>
          <% if (!clients.length) { %>
            <tr><td colspan="5" style="color:#94a3b8; text-align:center; padding:30px;">No clients found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<%- include('../partials/footer') %>
