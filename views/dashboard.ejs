<%- include('partials/header', { title: 'Dashboard' }) %>
  <div class="topbar">
    <div>
      <h1>Dashboard</h1>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="greeting">Welcome back, <%= currentUser.name %></div>
      <% } %>
    </div>
    <a href="/receipts/new" class="btn btn-primary">+ New Receipt</a>
  </div>
  <div class="content">
    <div class="grid grid-4">
      <div class="card stat-card" style="border-left:4px solid #1d4ed8;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <div class="stat-label">Quotations</div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </div>
        <div class="stat-value"><%= docCounts.quotation %></div>
      </div>
      <div class="card stat-card" style="border-left:4px solid #d97706;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <div class="stat-label">Invoices</div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 10h8M8 14h5"/></svg>
        </div>
        <div class="stat-value"><%= docCounts.invoice %></div>
      </div>
      <div class="card stat-card" style="border-left:4px solid #16a34a;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <div class="stat-label">Receipts</div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M4 3h16v18l-3-2-3 2-3-2-3 2-3-2-1 2z"/><path d="M8 8h8M8 12h8"/></svg>
        </div>
        <div class="stat-value"><%= docCounts.receipt %></div>
      </div>
      <div class="card stat-card" style="border-left:4px solid #7c3aed;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <div class="stat-label">Agreement Forms</div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><path d="M12 2l3 3h5v5l3 3-3 3v5h-5l-3 3-3-3H4v-5l-3-3 3-3V5h5z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div class="stat-value"><%= docCounts.agreement %></div>
      </div>
    </div>

    <div class="grid grid-4" style="margin-top:16px;">
      <div class="card stat-card">
        <div class="stat-label">Total Clients</div>
        <div class="stat-value"><%= totalClients %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Total Revenue (Receipts)</div>
        <div class="stat-value">KES <%= totalRevenue.toLocaleString('en-KE', {minimumFractionDigits:2}) %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">This Month</div>
        <div class="stat-value">KES <%= monthRevenue.toLocaleString('en-KE', {minimumFractionDigits:2}) %></div>
      </div>
      <div class="card stat-card" style="<%= outstandingInvoices > 0 ? 'border-left:4px solid #dc2626;' : '' %>">
        <div class="stat-label">Outstanding Invoices</div>
        <div class="stat-value" style="<%= outstandingInvoices > 0 ? 'color:#dc2626;' : '' %>">KES <%= outstandingInvoices.toLocaleString('en-KE', {minimumFractionDigits:2}) %></div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-top:20px;">
      <div class="card">
        <h3 style="margin-top:0;">Daily Revenue (last 7 days)</h3>
        <canvas id="dailyChart" height="140"></canvas>
        <table class="data-table" style="margin-top:14px;">
          <thead><tr><th>Date</th><th>Receipts</th><th>Revenue (KES)</th></tr></thead>
          <tbody>
            <% dailySummary.forEach(d => { %>
              <tr><td><%= d.day %></td><td><%= d.count %></td><td><%= d.revenue.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td></tr>
            <% }) %>
            <% if (!dailySummary.length) { %><tr><td colspan="3" style="color:#94a3b8;">No finalized receipts yet this week.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <div class="card">
        <h3 style="margin-top:0;">Monthly Revenue (last 6 months)</h3>
        <canvas id="monthlyChart" height="140"></canvas>
        <table class="data-table" style="margin-top:14px;">
          <thead><tr><th>Month</th><th>Receipts</th><th>Revenue (KES)</th></tr></thead>
          <tbody>
            <% monthlySummary.forEach(m => { %>
              <tr><td><%= m.month %></td><td><%= m.count %></td><td><%= m.revenue.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td></tr>
            <% }) %>
            <% if (!monthlySummary.length) { %><tr><td colspan="3" style="color:#94a3b8;">No finalized receipts yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid grid-2" style="margin-top:20px;">
      <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <h3 style="margin-top:0;">Recent Documents</h3>
          <a href="/reports" style="font-size:12.5px;">View all →</a>
        </div>
        <table class="data-table">
          <thead><tr><th>Number</th><th>Type</th><th>Client</th><th>Status</th><th>Total</th></tr></thead>
          <tbody>
            <% recentDocuments.forEach(d => { %>
              <tr>
                <td><a href="/<%= d.doc_type %>s/<%= d.id %>"><%= d.doc_number %></a></td>
                <td style="text-transform:capitalize;"><%= d.doc_type %></td>
                <td><%= d.customer_name %></td>
                <td><span class="badge badge-<%= d.status %>"><%= d.status %></span></td>
                <td>KES <%= d.total.toLocaleString('en-KE',{minimumFractionDigits:2}) %></td>
              </tr>
            <% }) %>
            <% if (!recentDocuments.length) { %><tr><td colspan="5" style="color:#94a3b8;">No documents yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <h3 style="margin-top:0;">Recent Clients</h3>
          <a href="/clients" style="font-size:12.5px;">View all →</a>
        </div>
        <table class="data-table">
          <thead><tr><th>Name</th><th>Phone</th><th>Since</th></tr></thead>
          <tbody>
            <% recentClients.forEach(c => { %>
              <tr>
                <td><a href="/clients/<%= c.id %>"><%= c.name %></a></td>
                <td><%= c.phone || '—' %></td>
                <td><%= c.created_at %></td>
              </tr>
            <% }) %>
            <% if (!recentClients.length) { %><tr><td colspan="3" style="color:#94a3b8;">No clients yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const dailyData = <%- JSON.stringify(dailySummary) %>;
    const monthlyData = <%- JSON.stringify(monthlySummary) %>;

    function drawBarChart(canvasId, data, labelKey, valueKey) {
      const canvas = document.getElementById(canvasId);
      if (!canvas || !data.length) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      const width = canvas.clientWidth || canvas.parentElement.clientWidth;
      const height = 140;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.scale(dpr, dpr);

      const max = Math.max(...data.map(d => d[valueKey]), 1);
      const padding = 24;
      const barGap = 10;
      const barWidth = (width - padding * 2 - barGap * (data.length - 1)) / data.length;

      ctx.clearRect(0, 0, width, height);
      data.forEach((d, i) => {
        const barHeight = (d[valueKey] / max) * (height - 30);
        const x = padding + i * (barWidth + barGap);
        const y = height - barHeight - 20;

        ctx.fillStyle = '#1d4ed8';
        ctx.fillRect(x, y, barWidth, barHeight);

        ctx.fillStyle = '#64748b';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        const label = String(d[labelKey]).slice(-5);
        ctx.fillText(label, x + barWidth / 2, height - 6);
      });
    }

    drawBarChart('dailyChart', dailyData, 'day', 'revenue');
    drawBarChart('monthlyChart', monthlyData, 'month', 'revenue');
    window.addEventListener('resize', () => {
      drawBarChart('dailyChart', dailyData, 'day', 'revenue');
      drawBarChart('monthlyChart', monthlyData, 'month', 'revenue');
    });
  </script>
<%- include('partials/footer') %>
