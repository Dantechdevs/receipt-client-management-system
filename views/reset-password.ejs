<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set New Password</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-box">
      <h1>Set New Password</h1>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/reset-password/<%= token %>" id="resetForm" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="password">New Password</label>
          <div style="position:relative;">
            <input class="form-control" id="password" type="password" name="password" required minlength="8"
                   style="padding-right:40px;">
            <button type="button" id="togglePw1" aria-label="Show password"
                    style="position:absolute; right:8px; top:50%; transform:translateY(-50%);
                           background:none; border:none; cursor:pointer; padding:4px; color:#64748b;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eyeOpen1">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eyeClosed1" style="display:none;">
                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
          <div style="font-size:12px; color:#94a3b8; margin-top:4px;">At least 8 characters.</div>
        </div>
        <div class="form-group">
          <label for="confirm">Confirm Password</label>
          <div style="position:relative;">
            <input class="form-control" id="confirm" type="password" name="confirm" required minlength="8"
                   style="padding-right:40px;">
            <button type="button" id="togglePw2" aria-label="Show password"
                    style="position:absolute; right:8px; top:50%; transform:translateY(-50%);
                           background:none; border:none; cursor:pointer; padding:4px; color:#64748b;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eyeOpen2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eyeClosed2" style="display:none;">
                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
          <div id="matchMsg" style="font-size:12px; margin-top:4px; min-height:14px;"></div>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;">Update password</button>
      </form>
    </div>
  </div>
  <footer class="devcredit">
    Developed by <a href="https://dantechdevelopers.com" target="_blank" rel="noopener noreferrer">Dantechdevs Developers</a>
  </footer>

  <script>
    function wireToggle(btnId, inputId, openClass, closedClass) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId);
      const openIcon = btn.querySelector('.' + openClass);
      const closedIcon = btn.querySelector('.' + closedClass);
      btn.addEventListener('click', () => {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        openIcon.style.display = show ? 'none' : 'block';
        closedIcon.style.display = show ? 'block' : 'none';
      });
    }
    wireToggle('togglePw1', 'password', 'eyeOpen1', 'eyeClosed1');
    wireToggle('togglePw2', 'confirm', 'eyeOpen2', 'eyeClosed2');

    const pwd = document.getElementById('password');
    const confirm = document.getElementById('confirm');
    const matchMsg = document.getElementById('matchMsg');

    function checkMatch() {
      if (!confirm.value) { matchMsg.textContent = ''; return; }
      if (pwd.value === confirm.value) {
        matchMsg.textContent = '✓ Passwords match';
        matchMsg.style.color = '#16a34a';
      } else {
        matchMsg.textContent = 'Passwords do not match';
        matchMsg.style.color = '#dc2626';
      }
    }
    pwd.addEventListener('input', checkMatch);
    confirm.addEventListener('input', checkMatch);
  </script>
</body>
</html>
